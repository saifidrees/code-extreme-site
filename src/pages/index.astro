---
import Base from "../layouts/Base.astro";
import Eyebrow from "../components/Eyebrow.astro";
import DecisionRow from "../components/DecisionRow.astro";
import { site, services, howIWork } from "../site.config";
---
<Base
  title="CodeExtreme — Saif Idrees, software engineer"
  description="I build the line-of-business systems companies run on: order flows, inventory, billing and the mobile apps and backends behind them. Contracted directly."
>
  <!-- Hero. The thesis is directness, stated once and then demonstrated by the
       rest of the page rather than repeated. -->
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-20 md:pt-28 md:pb-28">
    <Eyebrow text="CodeExtreme · Saif Idrees" />
    <h1 class="display-wide mt-8 max-w-4xl text-[2.75rem] text-ink sm:text-6xl md:text-7xl">
      I build the systems<br />a business runs on.
    </h1>
    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-ink-soft md:text-xl">
      Backends, APIs and the integrations between them. Thirteen years of it, for
      companies in Qatar, Sweden and Pakistan, usually as the only developer on
      the system.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a
        href={`mailto:${site.email}`}
        class="rounded-full bg-accent px-7 py-3.5 font-medium text-accent-ink hover:opacity-90"
      >Email me</a>
      <a href="/services" class="font-medium text-ink underline decoration-rule-strong underline-offset-4 hover:decoration-brand">
        What I build
      </a>
    </div>
  </section>

  <!-- What I build -->
  <section class="border-t border-rule bg-surface-raised">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <Eyebrow text="What I build" />
      <div class="mt-12 grid gap-x-10 gap-y-12 md:grid-cols-2">
        {services.map((s) => (
          <div class:list={[s.wide && "md:col-span-2 md:border-t md:border-rule md:pt-10"]}>
            <h2 class="display-tight text-2xl text-brand">{s.title}</h2>
            <p class="mt-2 font-mono text-sm text-brand">{s.lead}</p>
            <p class="mt-4 leading-relaxed text-ink-soft">{s.body}</p>
          </div>
        ))}
      </div>
      <a href="/services" class="anno mt-12 inline-block text-brand hover:underline">
        Services in detail &rarr;
      </a>
    </div>
  </section>

  <!-- The signature: the decision log. This is the section the page exists for. -->
  <section id="how-i-work" class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <Eyebrow text="How I work" />
    <p class="display-tight mt-8 max-w-3xl text-3xl text-ink md:text-4xl">
      Working with one engineer directly is a different arrangement to hiring an
      agency. Here is exactly what it means.
    </p>
    <div class="mt-14 border-b border-rule">
      {howIWork.map((row) => <DecisionRow claim={row.claim} reason={row.reason} />)}
    </div>
  </section>

  <!-- Product -->
  <section class="border-y border-rule bg-surface-deep text-white">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <p class="anno flex items-center gap-3 text-white/45">
        <span class="inline-block h-px w-8 bg-white/25" aria-hidden="true"></span>
        Product
      </p>
      <h2 class="display-wide mt-8 text-4xl md:text-5xl">SupplyO</h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/70">
        My own product: an ordering and delivery app for suppliers, built
        Urdu-first and running in pilot in Faisalabad. It is also the clearest
        public sample of how I build: offline-first sync, multi-role access,
        and an append-only billing ledger.
      </p>
      <div class="mt-10 flex flex-wrap gap-x-6 gap-y-3">
        <a href="/products" class="rounded-full bg-white px-6 py-3 font-medium text-ink hover:opacity-90">
          What it demonstrates
        </a>
        <a href="/supplyo" class="rounded-full border border-white/25 px-6 py-3 font-medium text-white hover:bg-white/10">
          Visit SupplyO
        </a>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <Eyebrow text="Contact" />
    <h2 class="display-tight mt-8 max-w-3xl text-3xl text-ink md:text-4xl">
      Tell me what you are trying to run better. I will tell you honestly whether
      software is the answer.
    </h2>
    <a
      href={`mailto:${site.email}`}
      class="mt-8 inline-block font-mono text-lg text-brand underline decoration-2 underline-offset-4 hover:opacity-80 md:text-xl"
    >{site.email}</a>
    <p class="mt-3">
      <a href={site.phoneHref} class="font-mono text-lg text-ink hover:text-brand">{site.phone}</a>
    </p>
    <p class="mt-6 text-sm text-ink-soft">
      Based in Faisalabad, {site.country}. Five hours ahead of London, ten ahead of New York.
    </p>
  </section>
</Base>
