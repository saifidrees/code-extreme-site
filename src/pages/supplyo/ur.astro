---
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import { site } from "../../site.config";

/*
 * Written, not translated — the rule the app itself follows (h2ogo-app
 * CLAUDE.md, "Urdu is written, not translated"): everyday English loanwords in
 * Urdu script, and the colloquial verb over the literary one.
 */
const steps = [
  { n: "۱", t: "آرڈر آتا ہے", b: "کسٹمر ڈائریکٹری میں آپ کو ڈھونڈ کر آرڈر کرتا ہے۔ آپ کو نوٹیفکیشن آ جاتی ہے — وہ فون کال نہیں جو مِس ہو جائے۔" },
  { n: "۲", t: "آپ ایکسیپٹ کرتے ہیں، یا نہیں", b: "آرڈر ایکسیپٹ کریں، بتائیں کہ کیا نہیں ہے، یا فون پر بات کر کے آرڈر بدل دیں۔ ہر جواب ایک ٹَیپ۔" },
  { n: "۳", t: "آپ راؤنڈ لگاتے ہیں", b: "آج کے آرڈر اور آپ کے پکے کسٹمر ایک ہی لسٹ میں، ہر سطر پر ایڈریس کے ساتھ۔" },
  { n: "۴", t: "بل بنائیں، پیسے لیں", b: "جو ڈیلیور کیا، اسی کا بل دروازے پر۔ جو باقی رہ جائے وہ اگلی بار کے بل میں آ جاتا ہے۔" },
];
---
<Base
  brand="supplyo"
  lang="ur"
  title="SupplyO — آرڈر لیں، راؤنڈ لگائیں، پیسے لیں"
  description="SupplyO سپلائرز کے لیے فری ایپ ہے۔ کسٹمر ڈائریکٹری سے آرڈر کرتے ہیں، آپ ایکسیپٹ کرتے ہیں، ڈیلیور کرتے ہیں اور دروازے پر بل بناتے ہیں۔"
>
  <div class="bg-brand-strong">
    <div class="mx-auto max-w-5xl px-6 py-24">
      <p class="text-sm text-accent">CodeExtreme کی طرف سے</p>
      <h1 class="mt-4 font-display text-4xl font-bold leading-tight text-white sm:text-5xl" dir="ltr">SupplyO</h1>
      <p class="mt-6 max-w-2xl text-xl leading-loose text-white/80">
        کسٹمر آپ کو ڈھونڈتے ہیں۔ آپ آرڈر لیتے ہیں، ڈیلیور کرتے ہیں، اور پیسے لیتے ہیں۔
        وہی پرانا کھاتہ، مگر حساب خود کرتا ہے۔
      </p>
      <p class="mt-8 inline-block rounded-lg bg-accent/15 px-4 py-2 font-bold text-accent">
        سپلائرز کے لیے فری
      </p>
      <p class="mt-8">
        <a href="/supplyo" class="text-white/70 underline hover:text-white" lang="en" dir="ltr">
          Read this page in English
        </a>
      </p>
    </div>
  </div>

  <Section title="یہ کیسے کام کرتی ہے">
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {steps.map((s) => (
        <div class="rounded-xl border border-rule bg-surface-raised p-6">
          <span class="text-2xl font-bold text-accent">{s.n}</span>
          <h3 class="mt-3 text-xl font-bold text-brand">{s.t}</h3>
          <p class="mt-2 leading-loose text-ink-soft">{s.b}</p>
        </div>
      ))}
    </div>
  </Section>

  <div class="border-y border-rule bg-surface-raised">
    <Section title="آپ جیسے کام کرتے ہیں، ویسی ہی بنائی ہے">
      <div class="mt-8 space-y-6 text-lg leading-loose text-ink-soft">
        <p><strong class="text-ink">اردو میں۔</strong> ہر سکرین، انہی الفاظ میں جو لوگ بولتے ہیں — کسی انگریزی ایپ کا ترجمہ نہیں۔</p>
        <p><strong class="text-ink">سگنل کے بغیر بھی چلتی ہے۔</strong> تہہ خانے یا گلی میں ڈیلیوری ریکارڈ کریں، سگنل آتے ہی چلی جاتی ہے۔ کوئی چیز دو بار نہیں لگتی۔</p>
        <p><strong class="text-ink">ریٹ آپ کے اپنے۔</strong> ہر صبح ایک سکرین پر پوری ریٹ لسٹ — وہی جو آپ واٹس ایپ گروپ میں بھیجتے ہیں۔</p>
        <p><strong class="text-ink">بیچنے والے آپ ہیں۔</strong> آپ کے کسٹمر، آپ کا سامان، آپ کے ریٹ، آپ کے پیسے۔ ایپ صرف کام کا حساب رکھتی ہے، اس میں سے حصہ نہیں لیتی۔</p>
      </div>
    </Section>
  </div>

  <Section title="SupplyO لیں">
    <p class="mt-4 max-w-2xl text-lg leading-loose text-ink-soft">
      SupplyO ابھی فیصل آباد میں پائلٹ پر ہے۔ اگر آپ پانی، گیس، دودھ، چکن یا سبزی
      سپلائی کرتے ہیں اور اپنے راؤنڈ کے لیے یہ ایپ چاہیے تو رابطہ کریں۔
    </p>
    <a href={`mailto:${site.email}`} class="mt-6 inline-block font-mono text-lg text-accent underline" dir="ltr">
      {site.email}
    </a>
  </Section>
</Base>
