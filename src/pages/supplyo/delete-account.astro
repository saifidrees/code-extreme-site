---
import Base from "../../layouts/Base.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Prose from "../../components/Prose.astro";
import { site } from "../../site.config";

/*
 * Google Play requires a web-accessible account deletion route for any app that
 * offers account creation, reachable without signing in. This page is that route.
 * It is a request form by email rather than a self-service button because the
 * backend has no deletion endpoint yet — see the backlog item. Do not describe
 * it as instant.
 */
const subject = encodeURIComponent("SupplyO — account deletion request");
const body = encodeURIComponent(
  "Please delete my SupplyO account.\n\n" +
  "Registered phone number: \n" +
  "Name on the account: \n\n" +
  "I understand that delivery and payment records kept by my supplier are retained."
);
---
<Base
  brand="supplyo"
  title="SupplyO — Delete your account"
  description="How to request deletion of your SupplyO account and personal information."
>
  <div class="mx-auto max-w-3xl px-6 pt-16 pb-16 md:pt-20">
    <Eyebrow text="Your account" />
    <h1 class="display-wide mt-8 text-4xl text-ink sm:text-5xl">Delete your SupplyO account</h1>

    <Prose>
      <p>
        You can ask us to delete your SupplyO account at any time. You do not need
        to be signed in, and you do not need your supplier's permission.
      </p>

      <h2>How to ask</h2>
      <p>
        Email <a href={`mailto:${site.email}?subject=${subject}&body=${body}`}>{site.email}</a>
        from any address, and tell us:
      </p>
      <ul>
        <li>the <strong>phone number</strong> your SupplyO account is registered to, and</li>
        <li>the <strong>name</strong> on the account.</li>
      </ul>
      <p>
        We may call that number to confirm the request is really from you. Without
        that check, anyone who knew your number could close your account.
      </p>
      <p>
        <a
          href={`mailto:${site.email}?subject=${subject}&body=${body}`}
          class="inline-block rounded-lg bg-accent px-6 py-3 font-bold text-accent-ink no-underline hover:opacity-90"
        >
          Email your deletion request
        </a>
      </p>

      <h2>What gets deleted</h2>
      <p>We delete, so that you can no longer be identified or signed in:</p>
      <ul>
        <li>your name, phone number and delivery address</li>
        <li>your sign-in credentials and any active sessions</li>
        <li>your notification token, so your phone stops receiving notifications</li>
      </ul>

      <h2>What is kept, and why</h2>
      <p>
        <strong>Records of deliveries, bills and payments are retained.</strong>
        They are not only your record. They are also your supplier's record of
        goods he sold and money he is owed or was paid, and he is required to keep
        his own accounts. Those retained records are no longer linked to your
        personal details.
      </p>
      <p>
        If a supplier still shows an unpaid balance against you, deleting your
        account does not settle it. That is a matter between you and him.
      </p>

      <h2>How long it takes</h2>
      <p>
        We respond within <strong>{site.deletionResponseDays} days</strong> of
        receiving your request, and confirm by phone or email once it is done.
      </p>

      <h2>Questions</h2>
      <p>
        See the <a href="/supplyo/privacy">privacy policy</a>, or write to
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </Prose>
  </div>
</Base>
