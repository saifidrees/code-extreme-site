---
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import { site } from "../../site.config";

const steps = [
  { n: "1", t: "The order arrives", b: "A customer finds you in the directory and orders. You get a notification — not a phone call you missed." },
  { n: "2", t: "You accept, or you don't", b: "Accept it, say what you don't have, or change the order after a quick call. Every answer is one tap." },
  { n: "3", t: "You run the round", b: "Today's orders and your standing customers in one list, with the address on every row." },
  { n: "4", t: "Bill and collect", b: "Bill at the door for what you delivered. What's owed carries to the next visit." },
];
---
<Base
  brand="supplyo"
  title="SupplyO — take orders, run your round, get paid"
  description="SupplyO is a free Urdu-first app for suppliers. Customers order from a directory; you accept, deliver and bill at the door."
>
  <div class="bg-brand-strong">
    <div class="mx-auto max-w-5xl px-6 py-24">
      <p class="font-mono text-sm uppercase tracking-widest text-accent">By CodeExtreme</p>
      <h1 class="mt-4 font-display text-4xl font-bold leading-tight text-white sm:text-5xl">SupplyO</h1>
      <p class="mt-6 max-w-2xl text-xl text-white/80">
        Customers find you. You take the order, deliver it, and get paid.
        The notebook, but it does the adding up.
      </p>
      <p class="mt-8 inline-block rounded-lg bg-accent/15 px-4 py-2 font-bold text-accent">
        Free for suppliers
      </p>
      <p class="mt-8">
        <a href="/supplyo/ur" class="text-white/70 underline hover:text-white" lang="ur" dir="rtl">
          یہ صفحہ اردو میں پڑھیں
        </a>
      </p>
    </div>
  </div>

  <Section title="How it works">
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {steps.map((s) => (
        <div class="rounded-xl border border-rule bg-surface-raised p-6">
          <span class="font-mono text-2xl font-bold text-accent">{s.n}</span>
          <h3 class="mt-3 font-display text-xl font-bold text-brand">{s.t}</h3>
          <p class="mt-2 leading-relaxed text-ink-soft">{s.b}</p>
        </div>
      ))}
    </div>
  </Section>

  <div class="border-y border-rule bg-surface-raised">
    <Section title="Built for how you already work">
      <div class="mt-8 space-y-6 text-lg leading-relaxed text-ink-soft">
        <p><strong class="text-ink">In Urdu.</strong> Every screen, in the words people actually use — not a translation of an English app.</p>
        <p><strong class="text-ink">Works without signal.</strong> Record a delivery in a basement or a back street; it syncs when you come back up. Nothing is entered twice.</p>
        <p><strong class="text-ink">You set your own rates.</strong> One screen each morning for the whole price list, the same one you photograph for the WhatsApp group.</p>
        <p><strong class="text-ink">You are the seller.</strong> Your customers, your goods, your prices, your money. SupplyO records the work — it does not take a cut of it.</p>
      </div>
    </Section>
  </div>

  <Section title="Get SupplyO">
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">
      SupplyO is in pilot in Faisalabad. If you supply water, gas, milk, chicken or
      vegetables and want it for your round, get in touch.
    </p>
    <a href={`mailto:${site.email}`} class="mt-6 inline-block font-mono text-lg text-accent underline">
      {site.email}
    </a>
  </Section>
</Base>
