---
import Base from "../layouts/Base.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { site } from "../site.config";

/*
 * Bio and timeline are drawn from Saif's CV. Employment history is his own
 * record — it names no client engagement and breaches no NDA — and it is the
 * strongest proof this site carries, since client work stays unnamed.
 *
 * Deliberately omitted: the live Swedish medicine-platform audit. It is a
 * current engagement, and a client under active contract does not need their
 * security review advertised. Ask Saif before adding it.
 *
 * Still stubbed: the photograph.
 */
const bio = [
  "I am a backend developer with thirteen years of building production systems for companies in Qatar, Sweden and Pakistan. Java, Spring Boot and PostgreSQL, mostly. The systems a business runs on, not the ones it shows off.",
  "For most of that time I have been the only developer on the system. Data modelling, API design, third-party integration, deployment, and the support years afterwards. One of the platforms I built is still in daily use and I still maintain it, six years on.",
  "More recently that has included reviewing codebases built with AI coding tools. Founders who shipped something that works, and need an honest read on what it will cost them at scale, before it gets expensive to find out.",
];

const experience = [
  {
    period: "2025–now",
    role: "Freelance backend consultant and technical auditor",
    org: "Independent · Remote",
    note: "Architecture and integration audits of AI-assisted codebases, plus continuing support and feature work on a live medical research platform in Qatar.",
  },
  {
    period: "2021–2025",
    role: "Backend developer",
    org: "PaperTale Technologies · Sweden, remote",
    note: "REST APIs behind iOS and Android apps for supply-chain traceability. ERP integration exposing supplier workforce data, and the core PostgreSQL schema as the product grew.",
  },
  {
    period: "2018–2019",
    role: "Team lead, part time",
    org: "TRIGSoft · Faisalabad",
    note: "Architecture decisions, planning and mentoring junior developers on client projects, alongside the Qatar work.",
  },
  {
    period: "2016–2021",
    role: "Java developer",
    org: "Fuego Digital Media · Qatar, remote",
    note: "Led the backend for a government-backed national awards platform, delivered solo to a fixed public deadline. Built a location-based capacity-booking app used by grocery stores and pharmacies through the COVID lockdowns.",
  },
  {
    period: "2013–2016",
    role: "Java developer",
    org: "QShield · Doha, Qatar",
    note: "Sole owner of an immigration services portal end to end: design, development, deployment and client contact. Used by companies to manage visa applications and document renewals.",
  },
  {
    period: "2011–2013",
    role: "Junior Java developer",
    org: "Fuego Digital Media · Doha, Qatar",
    note: "Client web applications on an in-house CMS. Placed with a Fuego client as an in-house developer after two years.",
  },
];

const stack = [
  { label: "Languages", items: "Java, SQL" },
  { label: "Frameworks", items: "Spring Boot, Vaadin Flow, jBPM, JPA" },
  { label: "Databases", items: "PostgreSQL (+ PostGIS), SQL Server" },
  { label: "Integration", items: "Zoho CRM, ERPNext, Klaviyo, BankID / GrandID" },
  { label: "Cloud", items: "Docker, AWS, Azure" },
  { label: "Mobile", items: "Flutter (Android, iOS)" },
];

const hasBio = bio.length > 0;
const hasExperience = experience.length > 0;
---
<Base
  title="About — CodeExtreme"
  description="Saif Idrees, software engineer. CodeExtreme is how I contract: directly, with the person who writes the code."
>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-16 md:pt-24">
    <Eyebrow text="About" />
    <div class="mt-8 grid gap-12 md:grid-cols-12">
      <div class="md:col-span-7">
        <h1 class="display-wide text-4xl text-ink sm:text-5xl md:text-6xl">
          Saif Idrees
        </h1>
        <p class="mt-4 font-mono text-brand">Software engineer · Faisalabad, Pakistan</p>

        {hasBio ? (
          <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink-soft">
            {bio.map((para) => <p>{para}</p>)}
          </div>
        ) : (
          <div class="mt-8 rounded-lg border border-dashed border-rule-strong bg-surface-raised p-6">
            <p class="anno text-ink-soft">Placeholder — not for publication</p>
            <p class="mt-3 leading-relaxed text-ink-soft">
              Biography goes here, written from the CV: what Saif builds, how long
              he has been doing it, and the domains he has worked in.
            </p>
          </div>
        )}
      </div>

      <div class="md:col-span-5">
        <div class="aspect-4/5 w-full overflow-hidden rounded-lg border border-dashed border-rule-strong bg-surface-raised">
          <div class="flex h-full items-center justify-center p-6 text-center">
            <p class="anno text-ink-faint">Photograph<br />to come</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {hasExperience && (
    <section class="border-t border-rule bg-surface-raised">
      <div class="mx-auto max-w-6xl px-6 py-20">
        <Eyebrow text="Experience" />
        <div class="mt-12 border-b border-rule">
          {experience.map((e) => (
            <div class="grid gap-2 border-t border-rule py-7 md:grid-cols-12 md:gap-8">
              <p class="font-mono text-sm text-ink-faint md:col-span-3 md:pt-1.5">{e.period}</p>
              <div class="md:col-span-4">
                <h3 class="display-tight text-xl text-ink">{e.role}</h3>
                <p class="mt-1 text-ink-soft">{e.org}</p>
              </div>
              <p class="text-ink-soft md:col-span-5 md:pt-1">{e.note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <Eyebrow text="What I work in" />
      <dl class="mt-12 grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
        {stack.map((row) => (
          <div class="border-t border-rule pt-5">
            <dt class="anno">{row.label}</dt>
            <dd class="mt-2 text-ink-soft">{row.items}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-12 border-t border-rule pt-5 text-ink-soft">
        <span class="anno">Education</span><br />
        <span class="mt-2 inline-block">BS Computer Science · Government College University, Faisalabad · 2010</span>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="display-tight max-w-3xl text-3xl text-ink md:text-4xl">
      If that is the arrangement you are looking for, say hello.
    </h2>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
      <a href="/#how-i-work" class="text-brand underline decoration-rule-strong underline-offset-4 hover:decoration-brand">How I work</a>
      sets out what contracting me directly actually involves.
    </p>
    <a
      href={`mailto:${site.email}`}
      class="mt-8 inline-block font-mono text-lg text-brand underline decoration-2 underline-offset-4 hover:opacity-80"
    >{site.email}</a>
  </section>
</Base>
