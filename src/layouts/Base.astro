---
import "../styles/global.css";
import { site } from "../site.config";

interface Props {
  title: string;
  description: string;
  /** Urdu pages flip the document direction and font; everything else is LTR. */
  lang?: "en" | "ur";
}
const { title, description, lang = "en" } = Astro.props;
const dir = lang === "ur" ? "rtl" : "ltr";
const home = lang === "ur" ? "/supplyo/ur" : "/";
---
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Manrope:wght@400;500;700;800&family=JetBrains+Mono:wght@400;600&family=Noto+Naskh+Arabic:wght@400;600;700&display=swap"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-rule bg-surface-raised">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a href={home} class="font-display text-xl font-bold text-brand">
          Code<span class="text-accent">Extreme</span>
        </a>
        <div class="flex items-center gap-6 text-sm font-medium">
          <a href="/supplyo" class="text-ink-soft hover:text-accent">SupplyO</a>
          <a href={`mailto:${site.email}`} class="text-ink-soft hover:text-accent">Contact</a>
        </div>
      </nav>
    </header>

    <main class="flex-1"><slot /></main>

    <footer class="border-t border-rule bg-surface-raised">
      <div class="mx-auto max-w-5xl px-6 py-10 text-sm text-ink-soft">
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a href="/supplyo" class="hover:text-accent">SupplyO</a>
          <a href="/supplyo/privacy" class="hover:text-accent">Privacy</a>
          <a href="/supplyo/delete-account" class="hover:text-accent">Delete your account</a>
          <a href={`mailto:${site.email}`} class="hover:text-accent">{site.email}</a>
        </div>
        <p class="mt-6">
          &copy; {new Date().getFullYear()} {site.legalName}. {site.country}.
        </p>
      </div>
    </footer>
  </body>
</html>
